@page "/index"
@rendermode InteractiveServer
@layout DashboardLayout

@using CoinSoul.Components.Layout
@using CoinSoul.Entities
@using CoinSoul.Trading.Core
@using CoinSoul.Trading.Engine
@using CoinSoul.Repository.DbContext
@using Microsoft.EntityFrameworkCore
@inject PortfolioStateService PortfolioState
@inject IDbContextFactory<CoinSoulDbContext> DbFactory
@inject ITradingEngine TradingEngine

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">

    <!-- HEADER -->
    <MudText Typo="Typo.h4" Class="mb-4" Style="color:#f1f5f9; font-weight:700;">
        📊 Executive Mission Control
    </MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <!-- SECTION 1: OVERVIEW CARDS -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-4" Style="background: rgba(15,23,42,.6); border:1px solid rgba(148,163,184,.12);">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Style="color:#94a3b8;">Bot Status</MudText>
                        <MudChip Color="@GetBotStatusColor(_botStatus)" Size="Size.Large" Style="font-weight:700;">
                            @_botStatus
                        </MudChip>
                        @if (!string.IsNullOrWhiteSpace(_lastError))
                        {
                            <MudText Typo="Typo.caption" Style="color:#ef4444;">
                                ⚠️ @_lastError
                            </MudText>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudPaper Class="pa-4" Style="background: rgba(15,23,42,.6); border:1px solid rgba(148,163,184,.12);">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Style="color:#94a3b8;">Total Equity</MudText>
                        <MudText Typo="Typo.h5" Style="color:#3b82f6; font-weight:700;">
                            $@_totalEquity.ToString("N2")
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#94a3b8;">
                            SOD: $@_startOfDayEquity.ToString("N2")
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudPaper Class="pa-4" Style="background: rgba(15,23,42,.6); border:1px solid rgba(148,163,184,.12);">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Style="color:#94a3b8;">Daily P&L</MudText>
                        <MudText Typo="Typo.h5" Style="@GetPnLColor(_dailyPnL)">
                            @_dailyPnL.ToString("+$0.00;-$0.00;$0.00")
                        </MudText>
                        <MudText Typo="Typo.caption" Style="@GetPnLColor(_dailyPnLPct)">
                            @_dailyPnLPct.ToString("+0.00%;-0.00%;0.00%")
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudPaper Class="pa-4" Style="background: rgba(15,23,42,.6); border:1px solid rgba(148,163,184,.12);">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Style="color:#94a3b8;">Open Positions</MudText>
                        <MudText Typo="Typo.h5" Style="color:#3b82f6; font-weight:700;">
                            @_openPositionsCount
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#94a3b8;">
                            Active trades
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- SECTION 2: RISK SNAPSHOT -->
        <MudPaper Class="pa-4 mb-4" Style="background: rgba(15,23,42,.6); border:1px solid rgba(148,163,184,.12);">
            <MudText Typo="Typo.h6" Class="mb-3" Style="color:#f1f5f9; font-weight:600;">
                🛡️ Risk Snapshot
            </MudText>

            @if (_riskState != null)
            {
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption" Style="color:#94a3b8;">Status</MudText>
                            <MudChip Color="@GetRiskStatusColor(_riskState.StatusColor)" Size="Size.Medium">
                                @_riskState.Status
                            </MudChip>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" md="3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption" Style="color:#94a3b8;">Drawdown</MudText>
                            <MudText Typo="Typo.h6" Style="@GetDrawdownColor(_riskState.DrawdownPct)">
                                @_riskState.DrawdownPct.ToString("0.00")%
                            </MudText>
                        </MudStack>
                    </MudItem>

                    @if (_riskState.PauseUntilUtc.HasValue)
                    {
                        <MudItem xs="12" md="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Style="color:#94a3b8;">Paused Until</MudText>
                                <MudText Typo="Typo.body2" Style="color:#f59e0b; font-weight:600;">
                                    @_riskState.PauseUntilUtc.Value.ToLocalTime().ToString("HH:mm:ss")
                                </MudText>
                            </MudStack>
                        </MudItem>
                    }

                    @if (_riskState.StopUntilUtc.HasValue)
                    {
                        <MudItem xs="12" md="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Style="color:#94a3b8;">Stopped Until</MudText>
                                <MudText Typo="Typo.body2" Style="color:#ef4444; font-weight:600;">
                                    @_riskState.StopUntilUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                </MudText>
                            </MudStack>
                        </MudItem>
                    }

                    @if (!string.IsNullOrWhiteSpace(_riskState.Message))
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Warning" Dense="true" 
                                      Style="background: rgba(245,158,11,.1); border: 1px solid rgba(245,158,11,.3);">
                                <MudText Style="color:#f59e0b;">@_riskState.Message</MudText>
                            </MudAlert>
                        </MudItem>
                    }
                </MudGrid>
            }
            else
            {
                <MudText Style="color:#94a3b8;">Loading risk status...</MudText>
            }
        </MudPaper>

        <!-- SECTION 3: MINI OPEN POSITIONS -->
        <MudPaper Class="pa-4 mb-4" Style="background: rgba(15,23,42,.6); border:1px solid rgba(148,163,184,.12);">
            <MudStack Row AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.h6" Style="color:#f1f5f9; font-weight:600;">
                    📌 Open Positions (Top 5)
                </MudText>
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary" 
                           Size="Size.Small" 
                           Href="/trading/live"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Open Live Monitor
                </MudButton>
            </MudStack>

            @if (_openPositions.Any())
            {
                <MudTable Items="_openPositions.Take(5)" Dense Hover Bordered Style="background: transparent;">
                    <HeaderContent>
                        <MudTh Style="color:#f1f5f9;">Symbol</MudTh>
                        <MudTh Style="color:#f1f5f9;">Entry Price</MudTh>
                        <MudTh Style="color:#f1f5f9;">Quantity</MudTh>
                        <MudTh Style="color:#f1f5f9;">Age</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="color:#3b82f6; font-weight:600;">@context.Symbol</MudTd>
                        <MudTd Style="color:#e2e8f0;">@context.EntryPrice.ToString("0.########")</MudTd>
                        <MudTd Style="color:#e2e8f0;">@context.Quantity.ToString("0.########")</MudTd>
                        <MudTd Style="color:#94a3b8;">@FormatAge(DateTime.UtcNow - context.OpenedAtUtc)</MudTd>
                    </RowTemplate>
                </MudTable>

                @if (_openPositionsCount > 5)
                {
                    <MudText Typo="Typo.caption" Class="mt-2" Style="color:#94a3b8;">
                        +@(_openPositionsCount - 5) more positions • View all in Live Monitor
                    </MudText>
                }
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true" 
                          Style="background: rgba(59,130,246,.1); border: 1px solid rgba(59,130,246,.3);">
                    <MudText Style="color:#3b82f6;">No open positions. Bot is scanning for opportunities.</MudText>
                </MudAlert>
            }
        </MudPaper>

        <!-- SECTION 4: MINI ACTIVITY FEED -->
        <MudPaper Class="pa-4 mb-4" Style="background: rgba(15,23,42,.6); border:1px solid rgba(148,163,184,.12);">
            <MudStack Row AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.h6" Style="color:#f1f5f9; font-weight:600;">
                    🔔 Recent Activity (Last 10)
                </MudText>
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary" 
                           Size="Size.Small" 
                           Href="/trading/logs"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Open Full Logs
                </MudButton>
            </MudStack>

            @if (_recentEvents.Any())
            {
                <MudStack Spacing="1">
                    @foreach (var evt in _recentEvents.Take(10))
                    {
                        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.caption" Style="color:#94a3b8; min-width:70px;">
                                @evt.AtUtc.ToLocalTime().ToString("HH:mm:ss")
                            </MudText>
                            <MudChip Size="Size.Small" Color="@GetEventLevelColor(evt.Level)">
                                @evt.Level
                            </MudChip>
                            <MudText Typo="Typo.body2" Style="color:#e2e8f0;">
                                @evt.Message
                            </MudText>
                        </MudStack>
                    }
                </MudStack>
            }
            else
            {
                <MudText Style="color:#94a3b8;">No recent events.</MudText>
            }
        </MudPaper>

        <!-- SECTION 5: MINI EQUITY CHART (7 DAYS) -->
        <MudPaper Class="pa-4" Style="background: rgba(15,23,42,.6); border:1px solid rgba(148,163,184,.12);">
            <MudStack Row AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.h6" Style="color:#f1f5f9; font-weight:600;">
                    📈 7-Day Equity Snapshot
                </MudText>
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary" 
                           Size="Size.Small" 
                           Href="/trading/analytics"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Open Analytics
                </MudButton>
            </MudStack>

            @if (_equitySnapshots.Any())
            {
                <MudTable Items="_equitySnapshots" Dense Hover Style="background: transparent;">
                    <HeaderContent>
                        <MudTh Style="color:#f1f5f9;">Date</MudTh>
                        <MudTh Style="color:#f1f5f9;">Equity (USDT)</MudTh>
                        <MudTh Style="color:#f1f5f9;">Daily Change</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="snapshot">
                        <MudTd Style="color:#94a3b8;">@snapshot.Date.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd Style="color:#3b82f6; font-weight:600;">$@snapshot.Equity.ToString("N2")</MudTd>
                        <MudTd Style="@GetPnLColor(snapshot.Change)">
                            @snapshot.Change.ToString("+$0.00;-$0.00;$0.00")
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true" 
                          Style="background: rgba(59,130,246,.1); border: 1px solid rgba(59,130,246,.3);">
                    <MudText Style="color:#3b82f6;">No equity snapshots available yet.</MudText>
                </MudAlert>
            }
        </MudPaper>
    }

</MudContainer>

@code {
    private bool _loading = true;

    // Section 1 - Overview
    private string _botStatus = "Unknown";
    private string? _lastError;
    private decimal _totalEquity;
    private decimal _startOfDayEquity;
    private decimal _dailyPnL;
    private decimal _dailyPnLPct;
    private int _openPositionsCount;

    // Section 2 - Risk
    private RiskStateDto? _riskState;

    // Section 3 - Positions
    private List<PositionEntity> _openPositions = new();

    // Section 4 - Events
    private List<EventEntity> _recentEvents = new();

    // Section 5 - Equity
    private List<EquitySnapshotRow> _equitySnapshots = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        _loading = true;

        try
        {
            // Load bot status
            var state = TradingEngine.GetState();
            _botStatus = state.Status.ToString();
            _lastError = state.LastError;

            // Load portfolio & risk
            var dashboardState = await PortfolioState.GetDashboardStateAsync(CancellationToken.None);
            _totalEquity = dashboardState.Portfolio.TotalEquityUsdt;
            _startOfDayEquity = dashboardState.Portfolio.StartOfDayEquityUsdt;
            _dailyPnL = _totalEquity - _startOfDayEquity;
            _dailyPnLPct = _startOfDayEquity > 0 ? (_dailyPnL / _startOfDayEquity) * 100 : 0;

            _riskState = dashboardState.Risk;

            // Load positions
            await using var db = await DbFactory.CreateDbContextAsync(CancellationToken.None);

            _openPositions = await db.Positions
                .AsNoTracking()
                .Where(p => p.IsOpen)
                .OrderByDescending(p => p.OpenedAtUtc)
                .Take(5)
                .ToListAsync();

            _openPositionsCount = await db.Positions.CountAsync(p => p.IsOpen);

            // Load events
            _recentEvents = await db.Events
                .AsNoTracking()
                .OrderByDescending(e => e.AtUtc)
                .Take(10)
                .ToListAsync();

            // Load equity snapshots (last 7 days)
            var sevenDaysAgo = DateTime.UtcNow.AddDays(-7).Date;
            var snapshots = await db.EquitySnapshotEntity
                .AsNoTracking()
                .Where(s => s.DayUtc >= sevenDaysAgo)
                .GroupBy(s => s.DayUtc)
                .Select(g => new
                {
                    Date = g.Key,
                    Equity = g.OrderByDescending(x => x.AtUtc).First().TotalEquityUsdt
                })
                .OrderBy(x => x.Date)
                .ToListAsync();

            _equitySnapshots = snapshots.Select((s, i) => new EquitySnapshotRow
            {
                Date = s.Date,
                Equity = s.Equity,
                Change = i > 0 ? s.Equity - snapshots[i - 1].Equity : 0
            }).ToList();
        }
        catch
        {
            // Silent fail - display partial data
        }
        finally
        {
            _loading = false;
        }
    }

    private static Color GetBotStatusColor(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "running" => Color.Success,
            "error" => Color.Error,
            "stopped" => Color.Warning,
            _ => Color.Default
        };
    }

    private static string GetPnLColor(decimal value)
    {
        if (value > 0)
            return "color:#22c55e; font-weight:700;";
        if (value < 0)
            return "color:#ef4444; font-weight:700;";
        return "color:#94a3b8;";
    }

    private static Color GetRiskStatusColor(string statusColor)
    {
        return statusColor.ToLowerInvariant() switch
        {
            "green" => Color.Success,
            "yellow" => Color.Warning,
            "orange" => Color.Warning,
            "red" => Color.Error,
            _ => Color.Default
        };
    }

    private static string GetDrawdownColor(decimal pct)
    {
        if (pct > 10m)
            return "color:#ef4444; font-weight:700;";
        if (pct > 5m)
            return "color:#f59e0b; font-weight:700;";
        return "color:#22c55e; font-weight:700;";
    }

    private static Color GetEventLevelColor(string? level)
    {
        return level?.ToUpperInvariant() switch
        {
            "ERROR" => Color.Error,
            "WARN" => Color.Warning,
            "INFO" => Color.Info,
            "TRADE" => Color.Success,
            _ => Color.Default
        };
    }

    private static string FormatAge(TimeSpan age)
    {
        if (age.TotalHours >= 1)
            return $"{age.TotalHours:0.0}h";
        if (age.TotalMinutes >= 1)
            return $"{age.TotalMinutes:0.0}m";
        return $"{age.TotalSeconds:0}s";
    }

    private sealed class EquitySnapshotRow
    {
        public DateTime Date { get; set; }
        public decimal Equity { get; set; }
        public decimal Change { get; set; }
    }
}
